QWidget {
    background: @bg_app@;
    color: @text_primary@;
    font-family: @ui_font@;
    font-size: @font_body@;
}

QMainWindow,
QStatusBar {
    background: @bg_app@;
}

QFrame#NavRail,
QFrame#Panel,
QFrame#TopBar,
QFrame#StatusStrip,
QFrame#InfoDrawer {
    background: @bg_panel@;
    border: 1px solid @border@;
    border-radius: @radius_panel@;
}

/* AI-P4: the broker credential-chain banner on Journal > Health. A bordered
   soft-accent strip, the idiom the retired Desk Link banner established
   (removed 2026-08-24, P1.5), because it is the same kind of message:
   something outside this app needs the trader's hand, and nothing inside it
   can fix itself. Styled here rather than per widget, so showing it costs a
   property set and not a stylesheet parse. */
QFrame#BrokerChainBanner {
    background: @accent_soft@;
    border: 1px solid @caution@;
    border-radius: 8px;
}

QFrame#TopBar {
    border-radius: 0;
    border-left: 0;
    border-right: 0;
    border-top: 0;
}

QLabel#TitleLabel {
    font-size: @font_title@;
    font-weight: 650;
    color: @text_primary@;
}

QLabel#SectionTitle {
    font-size: @font_section@;
    font-weight: 650;
    color: @text_primary@;
}

QLabel#SectionSubtitle,
QLabel#MutedLabel,
QStatusBar QLabel {
    color: @text_secondary@;
}

QLabel#CautionLabel {
    color: @caution@;
}

/* Day Recap coach: today's rule, on the status bar and the Market Prep page. */
QLabel#RuleChip {
    color: @caution@;
    font-weight: 600;
    padding: 0px 6px;
}

QLabel#RuleBanner {
    color: @caution@;
    font-weight: 600;
    padding: 4px 2px;
}

/* TJ-14A item 5: the Trade Mentor's internals strip. What the desk ALREADY
   read - breadth, fear, rates, oil, sector leaders and laggards - sits above
   the box the trader types into, so they write only what it cannot see. The
   variant lives here, keyed on object name, because a per-widget stylesheet is
   a parse on the Qt thread every time a card comes up (CLAUDE.md, performance
   rules) and this card comes up every hour. */
QWidget#MentorInternalsStrip {
    background: @accent_soft@;
    border: 1px solid @border@;
    border-radius: @radius@;
}

QLabel#MentorInternalsText {
    color: @text_secondary@;
    font-size: @font_body@;
}

QPushButton#MentorPredictionButton:checked,
QPushButton#MentorConfidenceButton:checked {
    background: @accent@;
    color: @bg_app@;
    font-weight: 650;
}

/* TJ-7: the mood strip. Nothing is pre-selected, so the UNCHECKED state has to
   read as "not answered" rather than as a quiet default - it stays secondary,
   and only the trader's own click takes the accent. Keyed on the object name
   here, never a per-widget stylesheet: both hosts draw the same strip. */
QPushButton#MoodFaceButton,
QPushButton#StateTagChipButton {
    color: @text_secondary@;
    padding: 2px 6px;
}

QPushButton#MoodFaceButton:checked,
QPushButton#StateTagChipButton:checked {
    background: @accent@;
    color: @bg_app@;
    font-weight: 650;
}

/* TJ-10: the Day Review read grader. A verdict is a MEASURED row, so the chip
   reads as a fact rather than as praise - `right` takes the long green, `wrong`
   the short red, `flat` and `pending` stay secondary, and an `unmeasured` one
   is muted because nobody measured it. Keyed on the object name and a `verdict`
   DYNAMIC PROPERTY, never a per-widget stylesheet: a stylesheet is a parse on
   the Qt thread, and this page repaints on every entry click. */
QLabel#VerdictChip {
    color: @text_secondary@;
    font-weight: 650;
}

QLabel#VerdictChip[verdict="right"] {
    color: @long@;
}

QLabel#VerdictChip[verdict="wrong"] {
    color: @short@;
}

QLabel#VerdictChip[verdict="flat"],
QLabel#VerdictChip[verdict="pending"] {
    color: @text_secondary@;
}

QLabel#VerdictChip[verdict="unmeasured"] {
    color: @text_muted@;
}

/* The three congruence lines under the story. Printed, never pushed: they are
   secondary text with no colour that means "act on me" (decision 0021
   answer 15). */
QLabel#CongruenceLines {
    color: @text_secondary@;
}

/* TJ-12's report card, at the head of Day Review. Six clickable lines, styled
   HERE and never with a per-widget stylesheet: a stylesheet set on the Qt
   thread is exactly the cost this page exists to avoid. A line reads as text,
   not as a button - it is a sentence you may click, not a verb. */
QFrame#DayReviewReportCard {
    border: 1px solid @border@;
    border-radius: 6px;
}

QPushButton#DayReviewReportCardLine {
    background: transparent;
    border: none;
    padding: 2px 0;
    text-align: left;
}

QPushButton#DayReviewReportCardLine:hover {
    color: @accent@;
}

/* Market Journal reader (G3): the meta line above the thought - session,
   timeframe, when it was written, who wrote it, the symbols. Secondary, so
   the words underneath are what the eye lands on. */
QLabel#ThoughtMeta {
    color: @text_secondary@;
}

/* ...and the thought itself: a document to READ, not an input box, so it
   drops the input background and border a QTextEdit would otherwise get. */
QTextBrowser#ThoughtReader {
    background: @bg_panel@;
    color: @text_primary@;
    border: 1px solid @border@;
    border-radius: @radius@;
    padding: @pad_small@;
    selection-background-color: @selection@;
}

/* Review-learning guidance line on the visual review pane: advisory
   take-prob / blind-spot notes. Favorite-gold so it reads as "the desk
   knows something here" without shouting. */
QLabel#GuidanceLabel {
    color: @favorite@;
}

/* The review pane's setup line: WHAT the exact setup is, readable at a
   glance from across the desk. When a live alert put the chart there it
   turns red (alertLive property), so it separates instantly from a chart
   the trader pulled up by typing a ticker. */
QLabel#ReviewSetupText {
    font-size: @font_setup@;
    font-weight: 600;
    color: @text_secondary@;
}

QLabel#ReviewSetupText[alertLive="true"] {
    color: @short@;
}

/* AR-2A: the same pure alert presentation classifier sets this property on
   the chart's reason and the feed's trigger.  It never changes an alert's
   route, queue, Focus membership or source timeframe. */
QLabel#ReviewSetupText[alertReasonTone="muted"] {
    color: @text_secondary@;
}

QLabel#ReviewSetupText[alertReasonTone="price"],
QLabel#ReviewSetupText[alertReasonTone="live"] {
    color: @short@;
}

QLabel#ReviewSetupText[alertReasonTone="focus"] {
    color: @long@;
}

QLabel#ReviewSetupText[alertReasonTone="d1"] {
    color: @chart_blue@;
}

QLabel#ReviewSetupText[alertReasonTone="pullback-m15"] {
    color: @chart_yellow@;
}

QLabel#ReviewSetupText[alertReasonTone="pullback-m30"] {
    color: @chart_purple@;
}

QLabel#ReviewSetupText[alertReasonTone="pullback-h1"] {
    color: @chart_light_blue@;
}

QPushButton,
QToolButton {
    background: @bg_elevated@;
    color: @text_primary@;
    border: 1px solid @border@;
    border-radius: @radius@;
    padding: @pad_small@ @pad_medium@;
}

QPushButton:hover,
QToolButton:hover {
    background: @bg_hover@;
    border-color: @accent@;
}

QPushButton:checked,
QToolButton:checked {
    background: @accent_soft@;
    border-color: @accent@;
    color: @text_primary@;
}

/* A button that rides an existing text row (the embedded snapshot pane's
   "Lines" control sits on the D1 legend line) must not make that row taller
   than the text already makes it. The general button chrome above - vertical
   padding plus a 1px border - costs the height-starved chart pane 5px, so a
   row-chrome button drops both and pays for its hit area with the row's own
   line height instead. Horizontal padding stays: it costs the chart nothing. */
QPushButton[rowChrome="true"],
QToolButton[rowChrome="true"] {
    background: transparent;
    border: none;
    padding: 0px @pad_small@;
}

QPushButton[rowChrome="true"]:hover,
QToolButton[rowChrome="true"]:hover {
    background: @bg_hover@;
    color: @accent@;
}

QPushButton#PrimaryButton {
    background: @accent@;
    border-color: @accent@;
    color: white;
    font-weight: 600;
}

QPushButton#NavButton {
    text-align: left;
    padding: @nav_pad_v@ @nav_pad_h@;
    border: 1px solid transparent;
    border-radius: @radius@;
    background: transparent;
    color: @text_secondary@;
    font-weight: 600;
}

QPushButton#NavButton:hover {
    background: @bg_hover@;
    border-color: @border@;
    color: @text_primary@;
}

QPushButton#NavButton:checked {
    background: @accent_soft@;
    border-color: @accent@;
    color: @text_primary@;
}

QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox,
QPlainTextEdit,
QTextEdit {
    background: @input_bg@;
    color: @text_primary@;
    border: 1px solid @border@;
    border-radius: @radius@;
    padding: @pad_small@;
    selection-background-color: @selection@;
}

/* Weekend Prep > Focus Review (packet G1). The nine tables are one stack
   behind a nine-button selector, and the selected row is read WHOLE in the
   pane beside it - the cell elides at paint time, this does not. Both are
   styled here by object name: the page builds no stylesheet of its own. */
QToolButton#WeekendViewButton {
    padding: @pad_small@ @pad_medium@;
}

QTextBrowser#WeekendRowDetail {
    background: @bg_panel@;
    color: @text_primary@;
    border: 1px solid @border@;
    border-radius: @radius@;
    padding: @pad_small@;
    selection-background-color: @selection@;
}

QTableView {
    background: @bg_panel@;
    alternate-background-color: @bg_elevated@;
    color: @text_primary@;
    border: 1px solid @border@;
    border-radius: @radius@;
    gridline-color: @border@;
    selection-background-color: @selection@;
    selection-color: @text_primary@;
}

QHeaderView::section {
    background: @bg_elevated@;
    color: @text_secondary@;
    border: 0;
    border-right: 1px solid @border@;
    border-bottom: 1px solid @border@;
    padding: @header_pad_v@ @header_pad_h@;
    font-weight: 650;
}

QTableView::item {
    min-height: @row_height@;
    padding-left: @cell_pad@;
    padding-right: @cell_pad@;
}

QTabWidget::pane {
    border: 1px solid @border@;
    border-radius: @radius@;
    top: -1px;
}

QTabBar::tab {
    background: @bg_elevated@;
    color: @text_secondary@;
    border: 1px solid @border@;
    border-bottom: 0;
    padding: @tab_pad_v@ @tab_pad_h@;
    border-top-left-radius: @radius@;
    border-top-right-radius: @radius@;
}

QTabBar::tab:selected {
    background: @bg_panel@;
    color: @text_primary@;
    border-color: @accent@;
}

QSplitter::handle {
    background: @border@;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background: @bg_app@;
    border: 0;
    width: @scrollbar@;
    height: @scrollbar@;
}

QScrollBar::handle {
    background: @border@;
    border-radius: @cell_pad@;
}

QScrollBar::handle:hover {
    background: @text_muted@;
}

/* ------------------------------------------------------------------ */
/* Alert feed rows and Focus chips.                                     */
/*                                                                      */
/* These were per-widget setStyleSheet calls in the constructors, which  */
/* made Qt parse CSS and recompute style once per row - up to 250 rows   */
/* on a feed rebuild, on the GUI thread. Stated once here, they are      */
/* parsed once at startup instead. The variants are selected with        */
/* dynamic properties; a widget that changes state calls                 */
/* style().unpolish/polish rather than setting a new stylesheet.         */
/* ------------------------------------------------------------------ */

QWidget#Panel[alertKind="watch"] {
    border: 1px solid @alert_watch_border@;
    border-left: 4px solid @short@;
    background: @alert_watch_bg@;
}

QWidget#Panel[alertKind="focus"] {
    border: 1px solid @alert_focus_border@;
    border-left: 4px solid @favorite@;
    background: @alert_focus_bg@;
}

/* Alert review colour key.  `alertTone` only changes presentation: routing
   still reads alert.timeframe (D1 for persistent Pullback rows). */
QWidget#Panel[alertTone="personal-d1"] {
    border: 1px solid @alert_watch_border@;
    border-left: 4px solid @short@;
    background: @alert_watch_bg@;
}

QWidget#Panel[alertTone="focus-d1"] {
    border: 1px solid @alert_focus_d1_border@;
    border-left: 4px solid @long@;
    background: @alert_focus_d1_bg@;
}

QWidget#Panel[alertTone="d1"] {
    border: 1px solid @alert_d1_border@;
    border-left: 4px solid @chart_blue@;
    background: @alert_d1_bg@;
}

QWidget#Panel[alertTone="pullback-m15"] {
    border: 1px solid @alert_pullback_m15_border@;
    border-left: 4px solid @chart_yellow@;
    background: @alert_pullback_m15_bg@;
}

QWidget#Panel[alertTone="pullback-m30"] {
    border: 1px solid @alert_pullback_m30_border@;
    border-left: 4px solid @chart_purple@;
    background: @alert_pullback_m30_bg@;
}

QWidget#Panel[alertTone="pullback-h1"] {
    border: 1px solid @alert_pullback_h1_border@;
    border-left: 4px solid @chart_light_blue@;
    background: @alert_pullback_h1_bg@;
}

QLabel#AlertSymbolLink {
    font-weight: 700;
    text-decoration: underline;
}

QLabel#AlertSymbolPlain {
    font-weight: 700;
}

QLabel#AlertTriggerWatch {
    color: @short@;
    font-weight: 700;
}

QLabel#AlertTrigger[alertReasonTone="muted"],
QLabel#AlertTriggerWatch[alertReasonTone="muted"] {
    color: @text_secondary@;
}

QLabel#AlertTrigger[alertReasonTone="price"],
QLabel#AlertTrigger[alertReasonTone="live"],
QLabel#AlertTriggerWatch[alertReasonTone="price"],
QLabel#AlertTriggerWatch[alertReasonTone="live"] {
    color: @short@;
}

QLabel#AlertTrigger[alertReasonTone="focus"],
QLabel#AlertTriggerWatch[alertReasonTone="focus"] {
    color: @long@;
}

QLabel#AlertTrigger[alertReasonTone="d1"],
QLabel#AlertTriggerWatch[alertReasonTone="d1"] {
    color: @chart_blue@;
}

QLabel#AlertTrigger[alertReasonTone="pullback-m15"],
QLabel#AlertTriggerWatch[alertReasonTone="pullback-m15"] {
    color: @chart_yellow@;
}

QLabel#AlertTrigger[alertReasonTone="pullback-m30"],
QLabel#AlertTriggerWatch[alertReasonTone="pullback-m30"] {
    color: @chart_purple@;
}

QLabel#AlertTrigger[alertReasonTone="pullback-h1"],
QLabel#AlertTriggerWatch[alertReasonTone="pullback-h1"] {
    color: @chart_light_blue@;
}

QToolButton#AlertFavoriteButton {
    color: @alert_star_dim@;
    font-weight: 700;
    padding: 0 6px;
}

QToolButton#AlertFavoriteButton[focusOn="true"] {
    color: @favorite@;
}

QToolButton#AlertDislikeButton {
    color: @alert_dislike@;
    font-weight: 700;
    font-size: 12pt;
    padding: 0 4px;
}

/* ------------------------------------------------------------------ */
/* Group RS/RW tape chips.                                              */
/*                                                                      */
/* These were an f-string setStyleSheet per chip inside GroupChip's      */
/* constructor, on a strip that deleted and re-created all of its chips  */
/* on every payload - up to 34 CSS parses and re-polishes every five     */
/* minutes, on the GUI thread. Stated once here, the variant now costs   */
/* a dynamic property set plus an unpolish/polish.                       */
/* ------------------------------------------------------------------ */

QFrame#GroupChip {
    border: 1px solid @group_chip_unknown_border@;
    border-radius: 6px;
    background: @group_chip_unknown_bg@;
}

QFrame#GroupChip[side="long"] {
    border: 1px solid @group_chip_long_border@;
    background: @group_chip_long_bg@;
}

QFrame#GroupChip[side="short"] {
    border: 1px solid @group_chip_short_border@;
    background: @group_chip_short_bg@;
}

QFrame#GroupChip QLabel {
    border: none;
    background: transparent;
}

QLabel#GroupChipName {
    color: @neutral@;
    font-weight: 700;
}

QLabel#GroupChipName[side="long"] {
    color: @long@;
}

QLabel#GroupChipName[side="short"] {
    color: @short@;
}

QLabel#GroupChipValue {
    color: @text_muted@;
}

/* ------------------------------------------------------------------ */
/* Today's swing picks - the trader's own vetted list, under the M5    */
/* alert list. Same rule as the group chips above: the side variant    */
/* and the "took" mark are dynamic properties answered here, so a chip */
/* costs a property set and a re-polish rather than a CSS parse.       */
/* ------------------------------------------------------------------ */

QFrame#SwingFavoriteChip {
    border: 1px solid @group_chip_unknown_border@;
    border-radius: 6px;
    background: @group_chip_unknown_bg@;
}

QFrame#SwingFavoriteChip[side="long"] {
    border: 1px solid @group_chip_long_border@;
    background: @group_chip_long_bg@;
}

QFrame#SwingFavoriteChip[side="short"] {
    border: 1px solid @group_chip_short_border@;
    background: @group_chip_short_bg@;
}

QFrame#SwingFavoriteChip[taken="true"] {
    border: 1px solid @favorite@;
}

QFrame#SwingFavoriteChip QLabel {
    border: none;
    background: transparent;
}

QLabel#SwingFavoriteName {
    color: @neutral@;
    font-weight: 700;
}

QLabel#SwingFavoriteName[side="long"] {
    color: @long@;
}

QLabel#SwingFavoriteName[side="short"] {
    color: @short@;
}

QLabel#SwingFavoriteTaken {
    color: @favorite@;
    font-weight: 700;
}


/* ST6 - the Working-lately strip at the top of the M5 alerts column.
   The variant is a DYNAMIC PROPERTY, never a per-widget setStyleSheet: the
   strip re-renders on every snapshot and a stylesheet set there recomputes the
   whole subtree to say nothing (re-review advisory 4). */
QFrame#WorkingLatelyStrip {
    background: transparent;
    border-bottom: 1px solid @border@;
}

QLabel#WorkingLatelyLine {
    color: @text_secondary@;
}

QFrame#WorkingLatelyStrip[hasSnapshot="true"] QLabel#WorkingLatelyLine {
    color: @text_primary@;
}

/* 2026-09-22 - the "Working now" strip under it. Same rule: the variant is a
   dynamic property, never a per-tick setStyleSheet. */
QFrame#LiveResultsStrip {
    background: transparent;
    border-bottom: 1px solid @border@;
}

QLabel#LiveResultsLine {
    color: @text_secondary@;
}

QFrame#LiveResultsStrip[hasRows="true"] QLabel#LiveResultsLine {
    color: @text_primary@;
}
