QWidget {
    background: @bg_app@;
    color: @text_primary@;
    font-family: @ui_font@;
    font-size: @font_body@;
}

QMainWindow,
QStatusBar {
    background: @bg_app@;
}

QFrame#NavRail,
QFrame#Panel,
QFrame#TopBar,
QFrame#StatusStrip,
QFrame#InfoDrawer {
    background: @bg_panel@;
    border: 1px solid @border@;
    border-radius: @radius_panel@;
}

/* AI-P4: the broker credential-chain banner on Journal > Health. A bordered
   soft-accent strip, the idiom the retired Desk Link banner established
   (removed 2026-08-24, P1.5), because it is the same kind of message:
   something outside this app needs the trader's hand, and nothing inside it
   can fix itself. Styled here rather than per widget, so showing it costs a
   property set and not a stylesheet parse. */
QFrame#BrokerChainBanner {
    background: @accent_soft@;
    border: 1px solid @caution@;
    border-radius: 8px;
}

QFrame#TopBar {
    border-radius: 0;
    border-left: 0;
    border-right: 0;
    border-top: 0;
}

QLabel#TitleLabel {
    font-size: @font_title@;
    font-weight: 650;
    color: @text_primary@;
}

QLabel#SectionTitle {
    font-size: @font_section@;
    font-weight: 650;
    color: @text_primary@;
}

QLabel#SectionSubtitle,
QLabel#MutedLabel,
QStatusBar QLabel {
    color: @text_secondary@;
}

QLabel#CautionLabel {
    color: @caution@;
}

/* Review-learning guidance line on the visual review pane: advisory
   take-prob / blind-spot notes. Favorite-gold so it reads as "the desk
   knows something here" without shouting. */
QLabel#GuidanceLabel {
    color: @favorite@;
}

/* The review pane's setup line: WHAT the exact setup is, readable at a
   glance from across the desk. When a live alert put the chart there it
   turns red (alertLive property), so it separates instantly from a chart
   the trader pulled up by typing a ticker. */
QLabel#ReviewSetupText {
    font-size: @font_setup@;
    font-weight: 600;
    color: @text_secondary@;
}

QLabel#ReviewSetupText[alertLive="true"] {
    color: @short@;
}

QPushButton,
QToolButton {
    background: @bg_elevated@;
    color: @text_primary@;
    border: 1px solid @border@;
    border-radius: @radius@;
    padding: @pad_small@ @pad_medium@;
}

QPushButton:hover,
QToolButton:hover {
    background: @bg_hover@;
    border-color: @accent@;
}

QPushButton:checked,
QToolButton:checked {
    background: @accent_soft@;
    border-color: @accent@;
    color: @text_primary@;
}

/* A button that rides an existing text row (the embedded snapshot pane's
   "Lines" control sits on the D1 legend line) must not make that row taller
   than the text already makes it. The general button chrome above - vertical
   padding plus a 1px border - costs the height-starved chart pane 5px, so a
   row-chrome button drops both and pays for its hit area with the row's own
   line height instead. Horizontal padding stays: it costs the chart nothing. */
QPushButton[rowChrome="true"],
QToolButton[rowChrome="true"] {
    background: transparent;
    border: none;
    padding: 0px @pad_small@;
}

QPushButton[rowChrome="true"]:hover,
QToolButton[rowChrome="true"]:hover {
    background: @bg_hover@;
    color: @accent@;
}

QPushButton#PrimaryButton {
    background: @accent@;
    border-color: @accent@;
    color: white;
    font-weight: 600;
}

QPushButton#NavButton {
    text-align: left;
    padding: @nav_pad_v@ @nav_pad_h@;
    border: 1px solid transparent;
    border-radius: @radius@;
    background: transparent;
    color: @text_secondary@;
    font-weight: 600;
}

QPushButton#NavButton:hover {
    background: @bg_hover@;
    border-color: @border@;
    color: @text_primary@;
}

QPushButton#NavButton:checked {
    background: @accent_soft@;
    border-color: @accent@;
    color: @text_primary@;
}

QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox,
QPlainTextEdit,
QTextEdit {
    background: @input_bg@;
    color: @text_primary@;
    border: 1px solid @border@;
    border-radius: @radius@;
    padding: @pad_small@;
    selection-background-color: @selection@;
}

QTableView {
    background: @bg_panel@;
    alternate-background-color: @bg_elevated@;
    color: @text_primary@;
    border: 1px solid @border@;
    border-radius: @radius@;
    gridline-color: @border@;
    selection-background-color: @selection@;
    selection-color: @text_primary@;
}

QHeaderView::section {
    background: @bg_elevated@;
    color: @text_secondary@;
    border: 0;
    border-right: 1px solid @border@;
    border-bottom: 1px solid @border@;
    padding: @header_pad_v@ @header_pad_h@;
    font-weight: 650;
}

QTableView::item {
    min-height: @row_height@;
    padding-left: @cell_pad@;
    padding-right: @cell_pad@;
}

QTabWidget::pane {
    border: 1px solid @border@;
    border-radius: @radius@;
    top: -1px;
}

QTabBar::tab {
    background: @bg_elevated@;
    color: @text_secondary@;
    border: 1px solid @border@;
    border-bottom: 0;
    padding: @tab_pad_v@ @tab_pad_h@;
    border-top-left-radius: @radius@;
    border-top-right-radius: @radius@;
}

QTabBar::tab:selected {
    background: @bg_panel@;
    color: @text_primary@;
    border-color: @accent@;
}

QSplitter::handle {
    background: @border@;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background: @bg_app@;
    border: 0;
    width: @scrollbar@;
    height: @scrollbar@;
}

QScrollBar::handle {
    background: @border@;
    border-radius: @cell_pad@;
}

QScrollBar::handle:hover {
    background: @text_muted@;
}

/* ------------------------------------------------------------------ */
/* Alert feed rows and Focus chips.                                     */
/*                                                                      */
/* These were per-widget setStyleSheet calls in the constructors, which  */
/* made Qt parse CSS and recompute style once per row - up to 250 rows   */
/* on a feed rebuild, on the GUI thread. Stated once here, they are      */
/* parsed once at startup instead. The variants are selected with        */
/* dynamic properties; a widget that changes state calls                 */
/* style().unpolish/polish rather than setting a new stylesheet.         */
/* ------------------------------------------------------------------ */

QWidget#Panel[alertKind="watch"] {
    border: 1px solid @alert_watch_border@;
    border-left: 4px solid @short@;
    background: @alert_watch_bg@;
}

QWidget#Panel[alertKind="focus"] {
    border: 1px solid @alert_focus_border@;
    border-left: 4px solid @favorite@;
    background: @alert_focus_bg@;
}

QLabel#AlertSymbolLink {
    font-weight: 700;
    text-decoration: underline;
}

QLabel#AlertSymbolPlain {
    font-weight: 700;
}

QLabel#AlertTriggerWatch {
    color: @short@;
    font-weight: 700;
}

QToolButton#AlertFavoriteButton {
    color: @alert_star_dim@;
    font-weight: 700;
    padding: 0 6px;
}

QToolButton#AlertFavoriteButton[focusOn="true"] {
    color: @favorite@;
}

QToolButton#AlertDislikeButton {
    color: @alert_dislike@;
    font-weight: 700;
    font-size: 12pt;
    padding: 0 4px;
}

/* ------------------------------------------------------------------ */
/* Group RS/RW tape chips.                                              */
/*                                                                      */
/* These were an f-string setStyleSheet per chip inside GroupChip's      */
/* constructor, on a strip that deleted and re-created all of its chips  */
/* on every payload - up to 34 CSS parses and re-polishes every five     */
/* minutes, on the GUI thread. Stated once here, the variant now costs   */
/* a dynamic property set plus an unpolish/polish.                       */
/* ------------------------------------------------------------------ */

QFrame#GroupChip {
    border: 1px solid @group_chip_unknown_border@;
    border-radius: 6px;
    background: @group_chip_unknown_bg@;
}

QFrame#GroupChip[side="long"] {
    border: 1px solid @group_chip_long_border@;
    background: @group_chip_long_bg@;
}

QFrame#GroupChip[side="short"] {
    border: 1px solid @group_chip_short_border@;
    background: @group_chip_short_bg@;
}

QFrame#GroupChip QLabel {
    border: none;
    background: transparent;
}

QLabel#GroupChipName {
    color: @neutral@;
    font-weight: 700;
}

QLabel#GroupChipName[side="long"] {
    color: @long@;
}

QLabel#GroupChipName[side="short"] {
    color: @short@;
}

QLabel#GroupChipValue {
    color: @text_muted@;
}
