QWidget {
    background: @bg_app@;
    color: @text_primary@;
    font-family: @ui_font@;
    font-size: @font_body@;
}

QMainWindow,
QStatusBar {
    background: @bg_app@;
}

QFrame#NavRail,
QFrame#Panel,
QFrame#TopBar,
QFrame#StatusStrip,
QFrame#InfoDrawer {
    background: @bg_panel@;
    border: 1px solid @border@;
    border-radius: @radius_panel@;
}

QFrame#DeskLinkBanner {
    background: @accent_soft@;
    border: 1px solid @caution@;
    border-radius: 8px;
}

QFrame#TopBar {
    border-radius: 0;
    border-left: 0;
    border-right: 0;
    border-top: 0;
}

QLabel#TitleLabel {
    font-size: @font_title@;
    font-weight: 650;
    color: @text_primary@;
}

QLabel#SectionTitle {
    font-size: @font_section@;
    font-weight: 650;
    color: @text_primary@;
}

QLabel#SectionSubtitle,
QLabel#MutedLabel,
QStatusBar QLabel {
    color: @text_secondary@;
}

QLabel#CautionLabel {
    color: @caution@;
}

/* Review-learning guidance line on the visual review pane: advisory
   take-prob / blind-spot notes. Favorite-gold so it reads as "the desk
   knows something here" without shouting. */
QLabel#GuidanceLabel {
    color: @favorite@;
}

/* The review pane's setup line: WHAT the exact setup is, readable at a
   glance from across the desk. When a live alert put the chart there it
   turns red (alertLive property), so it separates instantly from a chart
   the trader pulled up by typing a ticker. */
QLabel#ReviewSetupText {
    font-size: @font_setup@;
    font-weight: 600;
    color: @text_secondary@;
}

QLabel#ReviewSetupText[alertLive="true"] {
    color: @short@;
}

QPushButton,
QToolButton {
    background: @bg_elevated@;
    color: @text_primary@;
    border: 1px solid @border@;
    border-radius: @radius@;
    padding: @pad_small@ @pad_medium@;
}

QPushButton:hover,
QToolButton:hover {
    background: @bg_hover@;
    border-color: @accent@;
}

QPushButton:checked,
QToolButton:checked {
    background: @accent_soft@;
    border-color: @accent@;
    color: @text_primary@;
}

QPushButton#PrimaryButton {
    background: @accent@;
    border-color: @accent@;
    color: white;
    font-weight: 600;
}

QPushButton#NavButton {
    text-align: left;
    padding: @nav_pad_v@ @nav_pad_h@;
    border: 1px solid transparent;
    border-radius: @radius@;
    background: transparent;
    color: @text_secondary@;
    font-weight: 600;
}

QPushButton#NavButton:hover {
    background: @bg_hover@;
    border-color: @border@;
    color: @text_primary@;
}

QPushButton#NavButton:checked {
    background: @accent_soft@;
    border-color: @accent@;
    color: @text_primary@;
}

QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox,
QPlainTextEdit,
QTextEdit {
    background: @input_bg@;
    color: @text_primary@;
    border: 1px solid @border@;
    border-radius: @radius@;
    padding: @pad_small@;
    selection-background-color: @selection@;
}

QTableView {
    background: @bg_panel@;
    alternate-background-color: @bg_elevated@;
    color: @text_primary@;
    border: 1px solid @border@;
    border-radius: @radius@;
    gridline-color: @border@;
    selection-background-color: @selection@;
    selection-color: @text_primary@;
}

QHeaderView::section {
    background: @bg_elevated@;
    color: @text_secondary@;
    border: 0;
    border-right: 1px solid @border@;
    border-bottom: 1px solid @border@;
    padding: @header_pad_v@ @header_pad_h@;
    font-weight: 650;
}

QTableView::item {
    min-height: @row_height@;
    padding-left: @cell_pad@;
    padding-right: @cell_pad@;
}

QTabWidget::pane {
    border: 1px solid @border@;
    border-radius: @radius@;
    top: -1px;
}

QTabBar::tab {
    background: @bg_elevated@;
    color: @text_secondary@;
    border: 1px solid @border@;
    border-bottom: 0;
    padding: @tab_pad_v@ @tab_pad_h@;
    border-top-left-radius: @radius@;
    border-top-right-radius: @radius@;
}

QTabBar::tab:selected {
    background: @bg_panel@;
    color: @text_primary@;
    border-color: @accent@;
}

QSplitter::handle {
    background: @border@;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background: @bg_app@;
    border: 0;
    width: @scrollbar@;
    height: @scrollbar@;
}

QScrollBar::handle {
    background: @border@;
    border-radius: @cell_pad@;
}

QScrollBar::handle:hover {
    background: @text_muted@;
}
